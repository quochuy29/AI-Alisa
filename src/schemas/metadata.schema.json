{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/yourorg/requirement-commands/schemas/metadata.schema.json",
  "title": "Requirement Session Metadata",
  "description": "Schema for requirement session metadata.json files",
  "type": "object",
  "required": ["sessionId", "phase", "status", "createdAt", "updatedAt", "files"],
  "properties": {
    "sessionId": {
      "type": "string",
      "description": "Unique identifier for this requirement session (format: YYYY-MM-DD-HHMM-feature-slug)"
    },
    "phase": {
      "type": "string",
      "description": "Current phase of the requirement session",
      "enum": [
        "discovery",
        "context",
        "detail",
        "requirements_complete",
        "specs_generated",
        "design_approved",
        "specs_complete",
        "executing",
        "implemented",
        "bug_fixing",
        "change_review"
      ]
    },
    "status": {
      "type": "string",
      "description": "Status of the requirement session",
      "enum": ["active", "completed", "archived"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the session was created"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the session was last updated"
    },
    "files": {
      "type": "array",
      "description": "List of files in the requirement session",
      "items": {
        "type": "string"
      },
      "minItems": 12,
      "maxItems": 12
    }
  }
}
}
